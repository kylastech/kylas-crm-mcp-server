    {
      "name": "quotations searched by a rule (native)",
      "native": {
        "node": "kylas_search_entity",
        "arguments": {
          "entity_type": "quotation",
          "filter": {
            "condition": "AND",
            "rules": [
              {
                "id": "status",
                "field": "status",
                "operator": "equal",
                "type": "string",
                "value": "DRAFT"
              }
            ]
          }
        },
        "config": {},
        "output": {
          "status_code": 200,
          "results": [],
          "total": 3,
          "skipped": false
        }
      },
      "ui": {
        "label": "Open 3 quotations in list",
        "url": "/sales/quotations/list?status=equal&status=DRAFT&smartlist=Sherpa+search&sortByField=updatedAt&sortOrder=desc"
      },
      "link": {
        "type": "resource_link",
        "uri": "kylas://quotation",
        "name": "3 quotation result(s)",
        "_meta": {
          "com.kylas/action": "SearchAction",
          "com.kylas/entity": "quotation",
          "com.kylas/query": {
            "condition": "AND",
            "rules": [
              {
                "id": "status",
                "field": "status",
                "operator": "equal",
                "type": "string",
                "value": "DRAFT"
              }
            ],
            "valid": true
          },
          "com.kylas/count": 3
        }
      }
    },
    {
      "name": "leads searched by a filter (MCP)",
      "mcp": {
        "arguments": {
          "id": "lead.search",
          "payload": {
            "filters": [
              {
                "field": "city",
                "operator": "contains",
                "value": "Pune"
              }
            ]
          }
        },
        "answer": {
          "ok": true,
          "status": 200,
          "data": "Found 100 lead(s) (page 1 of 21, total 2012)\n• ID: 1"
        },
        "executedRule": {
          "condition": "AND",
          "valid": true,
          "rules": [
            {
              "operator": "contains",
              "id": "city",
              "field": "city",
              "type": "string",
              "value": "Pune",
              "relatedFieldIds": null
            }
          ]
        }
      },
      "ui": {
        "label": "Open 2012 leads in list",
        "url": "/sales/leads/list?city=contains&city=Pune&smartlist=Sherpa+search&sortByField=updatedAt&sortOrder=desc"
      },
      "link": {
        "name": "2012 lead result(s)",
        "uri": "kylas://lead",
        "_meta": {
          "com.kylas/action": "SearchAction",
          "com.kylas/entity": "lead",
          "com.kylas/query": {
            "condition": "AND",
            "rules": [
              {
                "field": "city",
                "operator": "contains",
                "type": "string",
                "value": "Pune"
              }
            ]
          },
          "com.kylas/count": 2012
        },
        "type": "resource_link"
      }
    },
    {
      "name": "leads searched by a date, as Kylas ran it in UTC (MCP)",
      "mcp": {
        "arguments": {
          "id": "lead.search",
          "payload": {
            "filters": [
              {
                "field": "createdAt",
                "operator": "greater",
                "value": "2026-11-01"
              }
            ]
          }
        },
        "answer": {
          "ok": true,
          "status": 200,
          "data": "Found 4 lead(s) (page 1 of 1, total 4)"
        },
        "executedRule": {
          "condition": "AND",
          "valid": true,
          "rules": [
            {
              "operator": "greater",
              "id": "createdAt",
              "field": "createdAt",
              "type": "date",
              "value": "2026-10-31T18:30:00.000Z",
              "timeZone": "Asia/Calcutta",
              "relatedFieldIds": null
            }
          ]
        }
      },
      "ui": {
        "label": "Open 4 leads in list",
        "url": "/sales/leads/list?createdAt=greater&createdAt=2026-10-31T18%3A30%3A00.000Z&smartlist=Sherpa+search&sortByField=updatedAt&sortOrder=desc"
      },
      "link": {
        "name": "4 lead result(s)",
        "uri": "kylas://lead",
        "_meta": {
          "com.kylas/action": "SearchAction",
          "com.kylas/entity": "lead",
          "com.kylas/query": {
            "condition": "AND",
            "rules": [
              {
                "field": "createdAt",
                "operator": "greater",
                "type": "date",
                "value": "2026-10-31T18:30:00.000Z"
              }
            ]
          },
          "com.kylas/count": 4
        },
        "type": "resource_link"
      }
