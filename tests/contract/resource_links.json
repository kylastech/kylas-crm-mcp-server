{
  "version": 1,
  "about": "The resource link contract, one case per entity and action. Source of truth: sd-ai-agent tests/contract/resource_links.json; copied verbatim to sd-ui (src/components/shared/AIFeatures/AIAgents/ResourceLinks/resource_links.contract.json) and kylas-crm-mcp-server (tests/contract/resource_links.json). Each repo checks its side: producers make `link` from `native`/`mcp`; sd-ui shows `link` as `ui`. An `mcp` case's `executedRule` is the jsonRule Kylas ran for it: the MCP server's search link carries it; sd-ai-agent's stopgap cannot see it, so its link is the same without `com.kylas/query`.",
  "cases": [
    {
      "name": "lead created (native)",
      "native": {
        "node": "kylas_create_entity",
        "arguments": {
          "entity_type": "lead"
        },
        "config": {},
        "output": {
          "status_code": 201,
          "data": {
            "id": 9,
            "firstName": "Asha",
            "lastName": "Rao"
          },
          "entity_id": 9
        }
      },
      "ui": {
        "label": "Created lead · Asha Rao",
        "url": "/sales/leads/details/9"
      },
      "link": {
        "type": "resource_link",
        "uri": "kylas://lead/9",
        "name": "Asha Rao",
        "_meta": {
          "com.kylas/action": "CreateAction",
          "com.kylas/entity": "lead",
          "com.kylas/id": 9
        }
      }
    },
    {
