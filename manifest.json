{
  "manifest_version": "0.2",
  "name": "kylas-crm-mcp-server",
  "display_name": "Kylas",
  "version": "1.0.13",
  "description": "MCP server to interact with Kylas CRM: create/manage leads, deals, contacts, tasks, companies, and meetings.",
  "long_description": "Connect Claude to your Kylas CRM account to create and manage leads, deals, contacts, tasks, companies, and meetings — all from natural language.",
  "author": {
    "name": "Kylas Tech",
    "url": "https://kylas.io"
  },
  "icon": "icon.png",
  "license": "MIT",
  "keywords": ["crm", "kylas", "leads", "deals", "contacts", "sales"],
  "compatibility": {
    "claude_desktop": ">=0.10.0",
    "platforms": ["darwin", "win32", "linux"],
    "runtimes": {
      "node": ">=18.0.0"
    }
  },
  "server": {
    "type": "node",
    "entry_point": "launcher.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/launcher.js"],
      "env": {
        "KYLAS_API_KEY": "${user_config.api_key}"
      }
    }
  },
  "user_config": {
    "api_key": {
      "type": "string",
      "title": "Kylas API Key",
      "description": "Your Kylas CRM API Key",
      "sensitive": true,
      "required": true
    }
  }
}
