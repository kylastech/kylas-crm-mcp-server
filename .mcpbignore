# node_modules is no longer shipped: mcp-remote and its full dependency tree are
# pre-bundled by esbuild into the single self-contained `proxy.bundled.mjs`. This
# collapses the bundle from ~660 files to ~4, which works around the Claude
# Desktop (Windows) regression where the .mcpb install dialog silently closes on
# bundles with large/deep node_modules trees (mcpb#281).
node_modules

